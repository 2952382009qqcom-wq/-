# LLM API 配置 (OpenAI 兼容接口)
# 支持 GPT-4 / DeepSeek / 通义千问 等任何兼容 API
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# MySQL 数据库配置
DATABASE_URL=mysql+pymysql://chatlaw:your-password@localhost:3306/chatlaw

# 管理员初始账号（生产环境请务必使用强密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Flask 密钥（用于 Session 加密，请替换为随机字符串）
SECRET_KEY=change-me-to-a-random-string

# 允许跨域的前端域名，多个域名用英文逗号分隔
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# 文档解析限制
# 支持 txt、md、pdf、docx、jpg、jpeg、png、webp
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=20
MAX_IMAGE_PIXELS=25000000
# PDF 文字层少于该有效字符数时，视为扫描页并尝试 OCR
MIN_PDF_TEXT_CHARS=20

# 健康检查与状态接口返回的应用版本标识
APP_VERSION=2026.09-competition

# 社区 / 案例 / 实时私聊（生产环境建议启用 Redis 与 Meilisearch）
RATELIMIT_STORAGE_URI=memory://
SOCKETIO_REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_TIMEOUT_SECONDS=2
# 首次启动自动写入经最高人民法院公开页面核验的案例；迁移流程中可设为 0
AUTO_SEED_REFERENCE_DATA=1
# 常规启动自动补建新增表；严格迁移部署可设为 0 后执行 flask db upgrade
AUTO_INIT_DB=1

# 私信附件与离线推荐产物（路径内容不应提交到 Git）
CHAT_ATTACHMENT_ROOT=instance/chat-attachments
CHAT_ATTACHMENT_MAX_BYTES=10485760
RECOMMENDER_ARTIFACT=instance/models/recommender-active.json

# 推送服务由部署方注入；不要在仓库里填写真实令牌
FCM_ENDPOINT=
FCM_BEARER_TOKEN=
